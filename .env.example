# Local profile name from ~/.okx/config.toml. Do not put credentials here.
OKX_READ_PROFILE=

# Explicit OKX region. The application must reject a missing or non-TR value.
OKX_SITE=

# Server-only JSON containing the user's validated risk policy, portfolio,
# requested amount and proxy limits. `executionRequested` must remain false.
ANALYSIS_REQUEST_JSON=

# Separate minimum-permission profile for explicitly confirmed live writes.
OKX_WRITE_PROFILE=

# Live writes remain disabled unless server configuration explicitly enables them.
OKX_EXECUTION_ENABLED=

# Hard server-side cap in the DCD notional currency for one live subscription.
OKX_MAX_LIVE_AMOUNT=

# Public deployment metadata; never place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_AVALANCHE_NETWORK=
NEXT_PUBLIC_DEPLOY_COMMIT=

# The official hackathon demo uses a temporary Cloudflare HTTPS URL while all
# OKX credentials and payment state remain on the local demo computer.

# Server-side deployment metadata exposed by /health. Set to the deployed Git SHA.
DEPLOY_COMMIT=

# Server-side x402 configuration. Wallet private keys do not belong in this file.
X402_PAY_TO_ADDRESS=
X402_PRICE=
X402_FACILITATOR_URL=
# Shared durable directory/volume for canonical paid reports and atomic replay claims.
# Production must not use an ephemeral per-instance path.
X402_REPLAY_STORE_DIR=

# Server-side web-to-API URL. In production prefer the platform private network.
ANALYSIS_API_URL=

# Facilitator signing key belongs only in the facilitator service's sealed secret store.
# Never share it with the API or web service and never commit its value.
LOCAL_FACILITATOR_PRIVATE_KEY=

# Optional LLM provider configuration. The model never performs financial math.
LLM_PROVIDER=
LLM_MODEL=
